---
import data from "../data/segunda.json";

const matches = data.matches;
const trends = data.trends;
const standings = data.standings;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Estadísticas, tendencias y datos de Segunda División y Championship."
    />

    <title>Segunda Fila</title>
  </head>

  <body>
    <header class="topbar">
      <div class="container header-content">
        <div class="brand">
          <div class="logo">SF</div>

          <div>
            <h1>Segunda Fila</h1>
            <p>Fútbol más allá de Primera</p>
          </div>
        </div>
      </div>
    </header>

    <main class="container page">
      <nav class="league-tabs">
        <button class="league-tab active">
          Segunda
        </button>

        <button class="league-tab disabled" disabled>
          Championship
        </button>
      </nav>

      <div class="content-grid">
        <div class="main-column">
          <!-- PARTIDOS -->

          <section class="panel">
            <div class="panel-header">
              <div>
                <h2>{data.matchSectionTitle}</h2>
              </div>
            </div>

            <div>
              {matches.map((match) => (
                <article class="match-row">
                  <div class="match-time">
                    {match.time}
                  </div>

                  <div class="teams">
                    <div class="team-row">
                      <div class="team-logo">
                        {match.home.charAt(0)}
                      </div>

                      <span>{match.home}</span>
                    </div>

                    <div class="team-row">
                      <div class="team-logo">
                        {match.away.charAt(0)}
                      </div>

                      <span>{match.away}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- TENDENCIAS -->

          <section class="panel">
            <div class="panel-header">
              <div>
                <h2>Tendencias</h2>
                <span>Datos destacados</span>
              </div>
            </div>

            <div>
              {trends.map((trend) => (
                <article class="trend-row">
                  <div class="trend-icon">
                    {trend.icon}
                  </div>

                  <div>
                    <strong>{trend.title}</strong>
                    <p>{trend.text}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        </div>

        <!-- CLASIFICACIÓN -->

        <aside class="panel standings-panel">
          <div class="panel-header">
            <div>
              <h2>Clasificación</h2>
              <span>Segunda División</span>
            </div>
          </div>

          <div class="standing-header">
            <span>#</span>
            <span>Equipo</span>
            <span>PJ</span>
            <span>PTS</span>
          </div>

          {standings.map((row) => (
            <div
              class:list={[
                "standing-row",
                row.pos <= 2 && "promotion",
                row.pos >= 3 && row.pos <= 6 && "playoff",
                row.pos >= 19 && "relegation"
              ]}
            >
              <span class="position">
                {row.pos}
              </span>

              <div class="standing-team">
                <div class="small-logo">
                  {row.team.charAt(0)}
                </div>

                <span>{row.team}</span>
              </div>

              <span>{row.played}</span>

              <strong>{row.points}</strong>
            </div>
          ))}
        </aside>
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #f3f4f6;
    color-scheme: light;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f3f4f6;
    color: #202124;
    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(button) {
    font: inherit;
  }

  /* GENERAL */

  .container {
    width: min(1100px, 94%);
    margin: 0 auto;
  }

  .page {
    padding: 24px 0 60px;
  }

  /* HEADER */

  .topbar {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .header-content {
    padding: 18px 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;

    border-radius: 10px;

    background: #111827;
    color: white;

    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: 20px;
  }

  .brand p {
    margin: 3px 0 0;
    color: #6b7280;
    font-size: 13px;
  }

  /* LEAGUE TABS */

  .league-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }

  .league-tab {
    border: none;
    background: transparent;
    color: #6b7280;

    padding: 9px 16px;

    border-radius: 20px;

    cursor: pointer;
    font-weight: 600;
  }

  .league-tab.active {
    background: #111827;
    color: white;
  }

  .league-tab.disabled {
    background: #eceef1;
    color: #b0b4bb;

    cursor: not-allowed;
    opacity: 0.65;
  }

  /* LAYOUT */

  .content-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 2fr)
      minmax(280px, 1fr);

    gap: 20px;
    align-items: start;
  }

  .main-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* PANELS */

  .panel {
    overflow: hidden;

    background: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 12px;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 18px 20px;

    border-bottom: 1px solid #eeeeee;
  }

  .panel-header h2 {
    margin: 0;
    font-size: 16px;
  }

  .panel-header span {
    display: block;
    margin-top: 3px;

    color: #9ca3af;

    font-size: 12px;
  }

  /* MATCHES */

  .match-row {
    display: grid;
    grid-template-columns: 65px minmax(0, 1fr);

    gap: 12px;
    align-items: center;

    padding: 16px 20px;

    border-bottom: 1px solid #f0f0f0;
  }

  .match-row:last-child {
    border-bottom: none;
  }

  .match-time {
    color: #6b7280;

    font-size: 13px;
    font-weight: 600;
  }

  .teams {
    display: flex;
    flex-direction: column;
    gap: 10px;

    min-width: 0;
  }

  .team-row {
    display: flex;
    align-items: center;

    gap: 10px;
    min-width: 0;

    font-size: 14px;
    font-weight: 600;
  }

  .team-row span {
    overflow: hidden;

    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .team-logo,
  .small-logo {
    flex-shrink: 0;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #f3f4f6;
    color: #4b5563;

    font-weight: 700;
  }

  .team-logo {
    width: 28px;
    height: 28px;
    font-size: 11px;
  }

  .small-logo {
    width: 24px;
    height: 24px;
    font-size: 10px;
  }

  /* TRENDS */

  .trend-row {
    display: flex;
    align-items: flex-start;

    gap: 14px;

    padding: 18px 20px;

    border-bottom: 1px solid #f0f0f0;
  }

  .trend-row:last-child {
    border-bottom: none;
  }

  .trend-icon {
    flex-shrink: 0;

    width: 36px;
    height: 36px;

    display: grid;
    place-items: center;

    background: #f3f4f6;

    border-radius: 8px;
  }

  .trend-row strong {
    font-size: 14px;
  }

  .trend-row p {
    margin: 4px 0 0;

    color: #6b7280;

    font-size: 13px;
    line-height: 1.4;
  }

  /* STANDINGS */

  .standing-header,
  .standing-row {
    display: grid;

    grid-template-columns:
      30px
      minmax(0, 1fr)
      35px
      40px;

    gap: 8px;
    align-items: center;

    padding: 10px 16px;
  }

  .standing-header {
    background: #fafafa;
    color: #9ca3af;

    font-size: 10px;
    font-weight: 700;
  }

  .standing-row {
    position: relative;

    border-top: 1px solid #f0f0f0;

    font-size: 13px;
  }

  .standing-row::before {
    content: "";

    position: absolute;

    left: 0;
    top: 6px;
    bottom: 6px;

    width: 3px;

    border-radius: 0 3px 3px 0;
  }

  .standing-row.promotion::before {
    background: #16a34a;
  }

  .standing-row.playoff::before {
    background: #86efac;
  }

  .standing-row.relegation::before {
    background: #ef4444;
  }

  .position {
    color: #6b7280;
    font-weight: 600;
  }

  .standing-team {
    display: flex;
    align-items: center;

    gap: 8px;
    min-width: 0;
  }

  .standing-team span {
    overflow: hidden;

    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* MOBILE */

  @media (max-width: 750px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .match-row {
      grid-template-columns: 55px minmax(0, 1fr);
      padding: 14px 16px;
    }

    .panel-header {
      padding: 16px;
    }

    .trend-row {
      padding: 16px;
    }
  }
</style>