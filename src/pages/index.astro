---
import data from "../data/segunda.json";

const todayMatches = data.todayMatches ?? [];
const journeyMatches = data.journeyMatches ?? [];
const trends = data.trends ?? [];
const standings = data.standings ?? [];

const journeyByDay = journeyMatches.reduce((acc, match) => {
  const day = match.dateLabel ?? "";

  if (!acc[day]) {
    acc[day] = [];
  }

  acc[day].push(match);

  return acc;
}, {});
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Estadísticas, tendencias y datos de Segunda División y Championship."
    />

    <title>Segunda Fila</title>
  </head>

  <body>
    <header class="topbar">
      <div class="container header-content">
        <div class="brand">
          <div class="logo">SF</div>

          <div>
            <h1>Segunda Fila</h1>
            <p>Fútbol más allá de Primera</p>
          </div>
        </div>
      </div>
    </header>

    <main class="container page">
      <!-- LIGAS -->

      <nav class="league-tabs">
        <button class="league-tab active">
          Segunda
        </button>

        <button
          class="league-tab disabled"
          disabled
        >
          Championship
        </button>
      </nav>

      <div class="content-grid">
        <div class="main-column">

          <!-- PARTIDOS DE HOY -->

          <section class="panel">
            <div class="panel-header">
              <div>
                <h2>Partidos de hoy</h2>
                <span>Resultados y horarios se actualizan periódicamente</span>
              </div>
            </div>

            {
              todayMatches.length > 0 ? (
                <div class="matches-list">

                  {todayMatches.map((match) => (

                    <article
                      class="match-row"
                      data-match
                      data-kickoff={match.kickoffUtc}
                      data-status={match.status ?? ""}
                    >
                      <div class="match-time">
                        <span data-match-status>
                          {match.time}
                        </span>
                      </div>

                      <div class="teams">
                        <div class="team-row">
                          <div class="team-logo">
                            {match.home.charAt(0)}
                          </div>

                          <span>{match.home}</span>

                          {
                            match.homeScore !== null &&
                            match.homeScore !== ""
                              ? (
                                <strong class="score">
                                  {match.homeScore}
                                </strong>
                              )
                              : null
                          }
                        </div>

                        <div class="team-row">
                          <div class="team-logo">
                            {match.away.charAt(0)}
                          </div>

                          <span>{match.away}</span>

                          {
                            match.awayScore !== null &&
                            match.awayScore !== ""
                              ? (
                                <strong class="score">
                                  {match.awayScore}
                                </strong>
                              )
                              : null
                          }
                        </div>
                      </div>
                    </article>

                  ))}

                </div>
              ) : (
                <div class="empty-state">
                  No hay partidos de Segunda hoy.
                </div>
              )
            }
          </section>

          <!-- ESTA JORNADA -->

          <section class="panel">
            <div class="panel-header">
              <div>
                <h2>Esta jornada</h2>
                <span>Los partidos del finde</span>
              </div>
            </div>

            {
              Object.keys(journeyByDay).length > 0 ? (
                <div class="matchday-list">

                  {Object.entries(journeyByDay).map(
                    ([day, matches]) => (

                      <div class="matchday-group">

                        <div class="matchday-title">
                          {day}
                        </div>

                        <div class="matches-list">

                          {matches.map((match) => (

                            <article
                              class="match-row"
                              data-match
                              data-kickoff={match.kickoffUtc}
                              data-status={match.status ?? ""}
                            >
                              <div class="match-time">
                                <span data-match-status>
                                  {match.time}
                                </span>
                              </div>

                              <div class="teams">

                                <div class="team-row">
                                  <div class="team-logo">
                                    {match.home.charAt(0)}
                                  </div>

                                  <span>{match.home}</span>

                                  {
                                    match.homeScore !== null &&
                                    match.homeScore !== ""
                                      ? (
                                        <strong class="score">
                                          {match.homeScore}
                                        </strong>
                                      )
                                      : null
                                  }
                                </div>

                                <div class="team-row">
                                  <div class="team-logo">
                                    {match.away.charAt(0)}
                                  </div>

                                  <span>{match.away}</span>

                                  {
                                    match.awayScore !== null &&
                                    match.awayScore !== ""
                                      ? (
                                        <strong class="score">
                                          {match.awayScore}
                                        </strong>
                                      )
                                      : null
                                  }
                                </div>

                              </div>
                            </article>

                          ))}

                        </div>
                      </div>

                    )
                  )}

                </div>
              ) : (
                <div class="empty-state">
                  No hay más partidos disponibles para esta jornada.
                </div>
              )
            }
          </section>

          <!-- TENDENCIAS -->

          <section class="panel">
            <div class="panel-header">
              <div>
                <h2>Tendencias</h2>
                <span>Datos destacados</span>
              </div>
            </div>

            <div>
              {trends.map((trend) => (
                <article class="trend-row">

                  <div class="trend-icon">
                    {trend.icon}
                  </div>

                  <div>
                    <strong>{trend.title}</strong>
                    <p>{trend.text}</p>
                  </div>

                </article>
              ))}
            </div>
          </section>

        </div>

        <!-- CLASIFICACIÓN -->

        <aside class="panel standings-panel">
          <div class="panel-header">
            <div>
              <h2>Clasificación</h2>
              <span>Segunda División</span>
            </div>
          </div>

          <div class="standing-header">
            <span>#</span>
            <span>Equipo</span>
            <span>PJ</span>
            <span>PTS</span>
          </div>

          {standings.map((row) => (
            <div
              class:list={[
                "standing-row",
                row.pos <= 2 && "promotion",
                row.pos >= 3 &&
                  row.pos <= 6 &&
                  "playoff",
                row.pos >= 19 &&
                  "relegation"
              ]}
            >
              <span class="position">
                {row.pos}
              </span>

              <div class="standing-team">
                <div class="small-logo">
                  {row.team.charAt(0)}
                </div>

                <span>{row.team}</span>
              </div>

              <span>{row.played}</span>

              <strong>{row.points}</strong>
            </div>
          ))}
        </aside>
      </div>
    </main>

    <!-- ESTADO EN CURSO -->

    <script is:inline>
      function updateMatchStatuses() {
        const matches =
          document.querySelectorAll("[data-match]");

        const now = new Date();

        matches.forEach((match) => {
          const kickoffValue =
            match.dataset.kickoff;

          const rawStatus =
            (match.dataset.status || "").toLowerCase();

          const statusElement =
            match.querySelector("[data-match-status]");

          if (!kickoffValue || !statusElement) {
            return;
          }

          const kickoff =
            new Date(kickoffValue);

          const matchEnd =
            new Date(
              kickoff.getTime() +
              135 * 60 * 1000
            );

          const finished =
            rawStatus.includes("finished") ||
            rawStatus.includes("ft");

          statusElement.classList.remove(
            "status-live",
            "status-final"
          );

          if (finished) {
            statusElement.textContent = "FINAL";
            statusElement.classList.add("status-final");

            return;
          }

          if (
            now >= kickoff &&
            now <= matchEnd
          ) {
            statusElement.textContent = "EN CURSO";
            statusElement.classList.add("status-live");

            return;
          }

          if (now > matchEnd) {
            statusElement.textContent = "FINAL";
            statusElement.classList.add("status-final");

            return;
          }

          const formatter =
            new Intl.DateTimeFormat(
              "es-ES",
              {
                hour: "2-digit",
                minute: "2-digit",
                timeZone: "Europe/Madrid"
              }
            );

          statusElement.textContent =
            formatter.format(kickoff);
        });
      }

      updateMatchStatuses();

      setInterval(
        updateMatchStatuses,
        30000
      );
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #f3f4f6;
    color-scheme: light;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;

    background: #f3f4f6;
    color: #202124;

    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(button) {
    font: inherit;
  }

  /* GENERAL */

  .container {
    width: min(1100px, 94%);
    margin: 0 auto;
  }

  .page {
    padding: 24px 0 60px;
  }

  /* HEADER */

  .topbar {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .header-content {
    padding: 18px 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    background: #111827;
    color: #ffffff;

    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: 20px;
  }

  .brand p {
    margin: 3px 0 0;

    color: #6b7280;

    font-size: 13px;
  }

  /* TABS */

  .league-tabs {
    display: flex;
    gap: 8px;

    margin-bottom: 20px;
  }

  .league-tab {
    padding: 9px 16px;

    border: none;
    border-radius: 20px;

    background: transparent;
    color: #6b7280;

    font-weight: 600;

    cursor: pointer;
  }

  .league-tab.active {
    background: #111827;
    color: #ffffff;
  }

  .league-tab.disabled {
    background: #eceef1;
    color: #b0b4bb;

    cursor: not-allowed;

    opacity: 0.65;
  }

  /* LAYOUT */

  .content-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 2fr)
      minmax(280px, 1fr);

    gap: 20px;

    align-items: start;
  }

  .main-column {
    display: flex;
    flex-direction: column;

    gap: 20px;
  }

  /* PANEL */

  .panel {
    overflow: hidden;

    background: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 12px;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 18px 20px;

    border-bottom: 1px solid #eeeeee;
  }

  .panel-header h2 {
    margin: 0;

    font-size: 16px;
    font-weight: 700;
  }

  .panel-header span {
    display: block;

    margin-top: 4px;

    color: #9ca3af;

    font-size: 12px;
    font-weight: 400;
  }

  /* JORNADA */

  .matchday-list {
    width: 100%;
  }

  .matchday-group {
    width: 100%;
  }

  .matchday-group + .matchday-group {
    border-top: 8px solid #f3f4f6;
  }

  .matchday-title {
    display: flex;
    align-items: center;

    width: 100%;
    min-height: 38px;

    padding: 10px 20px;

    background: #f8f9fa;
    color: #4b5563;

    border-bottom: 1px solid #eeeeee;

    font-size: 12px;
    font-weight: 700;
    line-height: 18px;
  }

  /* PARTIDOS */

  .matches-list {
    width: 100%;
  }

  .match-row {
    display: grid;

    grid-template-columns:
      68px
      minmax(0, 1fr);

    gap: 14px;

    align-items: center;

    min-height: 78px;

    padding: 14px 20px;

    border-bottom: 1px solid #f0f0f0;
  }

  .match-row:last-child {
    border-bottom: none;
  }

  .match-time {
    display: flex;
    align-items: center;

    min-width: 0;
  }

  .match-time span {
    display: inline-flex;
    align-items: center;

    min-height: 24px;

    color: #6b7280;

    font-size: 13px;
    font-weight: 600;
    line-height: 1;

    white-space: nowrap;
  }

  .match-time span.status-live {
    color: #dc2626;
    font-size: 11px;
    font-weight: 800;
  }

  .match-time span.status-final {
    color: #6b7280;
    font-size: 11px;
    font-weight: 700;
  }

  .teams {
    display: flex;
    flex-direction: column;

    gap: 9px;

    min-width: 0;
  }

  .team-row {
    display: flex;
    align-items: center;

    gap: 10px;

    min-width: 0;

    font-size: 14px;
    font-weight: 600;
  }

  .team-row > span {
    flex: 1;

    min-width: 0;

    overflow: hidden;

    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .score {
    flex-shrink: 0;

    width: 24px;

    color: #111827;

    text-align: right;

    font-size: 15px;
    font-weight: 700;
  }

  .team-logo,
  .small-logo {
    flex-shrink: 0;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #f3f4f6;
    color: #4b5563;

    font-weight: 700;
  }

  .team-logo {
    width: 28px;
    height: 28px;

    font-size: 11px;
  }

  .small-logo {
    width: 24px;
    height: 24px;

    font-size: 10px;
  }

  .empty-state {
    padding: 26px 20px;

    color: #9ca3af;

    text-align: center;

    font-size: 13px;
  }

  /* TENDENCIAS */

  .trend-row {
    display: flex;
    align-items: flex-start;

    gap: 14px;

    padding: 18px 20px;

    border-bottom: 1px solid #f0f0f0;
  }

  .trend-row:last-child {
    border-bottom: none;
  }

  .trend-icon {
    flex-shrink: 0;

    width: 36px;
    height: 36px;

    display: grid;
    place-items: center;

    background: #f3f4f6;

    border-radius: 8px;
  }

  .trend-row strong {
    font-size: 14px;
  }

  .trend-row p {
    margin: 4px 0 0;

    color: #6b7280;

    font-size: 13px;
    line-height: 1.4;
  }

  /* CLASIFICACIÓN */

  .standing-header,
  .standing-row {
    display: grid;

    grid-template-columns:
      30px
      minmax(0, 1fr)
      35px
      40px;

    gap: 8px;

    align-items: center;

    padding: 10px 16px;
  }

  .standing-header {
    background: #fafafa;
    color: #9ca3af;

    font-size: 10px;
    font-weight: 700;
  }

  .standing-row {
    position: relative;

    border-top: 1px solid #f0f0f0;

    font-size: 13px;
  }

  .standing-row::before {
    content: "";

    position: absolute;

    left: 0;
    top: 6px;
    bottom: 6px;

    width: 3px;

    border-radius: 0 3px 3px 0;
  }

  .standing-row.promotion::before {
    background: #16a34a;
  }

  .standing-row.playoff::before {
    background: #86efac;
  }

  .standing-row.relegation::before {
    background: #ef4444;
  }

  .position {
    color: #6b7280;

    font-weight: 600;
  }

  .standing-team {
    display: flex;
    align-items: center;

    gap: 8px;

    min-width: 0;
  }

  .standing-team span {
    overflow: hidden;

    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* MOBILE */

  @media (max-width: 750px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .panel-header {
      padding: 16px;
    }

    .matchday-title {
      min-height: 36px;

      padding: 9px 16px;
    }

    .match-row {
      grid-template-columns:
        62px
        minmax(0, 1fr);

      gap: 10px;

      padding: 14px 16px;
    }

    .trend-row {
      padding: 16px;
    }
  }
</style>