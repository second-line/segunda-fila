---
import data from "../data/segunda.json";

const todayMatches = data.todayMatches ?? [];
const journeyMatches = data.journeyMatches ?? [];
const trends = data.trends ?? [];
const standings = data.standings ?? [];
const teams = data.teams ?? [];

const journeyByDay = journeyMatches.reduce((acc, match) => {
  const day = match.dateLabel ?? "";

  if (!acc[day]) {
    acc[day] = [];
  }

  acc[day].push(match);

  return acc;
}, {});

const isProviderFinished = (match) => {
  const status = (match.status ?? "").toLowerCase();

  return (
    status.includes("finished") ||
    status.includes("ft")
  );
};

const isMatchCurrentlyLive = (match) => {
  if (!match.kickoffUtc || isProviderFinished(match)) {
    return false;
  }

  const kickoff = new Date(match.kickoffUtc);
  const now = new Date();

  const estimatedEnd = new Date(
    kickoff.getTime() + 135 * 60 * 1000
  );

  return (
    now >= kickoff &&
    now <= estimatedEnd
  );
};

const getMatchUrl = (match) => {
  if (
    !match.matchSlug ||
    isMatchCurrentlyLive(match)
  ) {
    return null;
  }

  return `/segunda/partidos/${match.matchSlug}`;
};
