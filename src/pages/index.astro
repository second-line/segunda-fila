    </main>

   <script is:inline>
  function setMatchClickable(
    match,
    clickable
  ) {
    const matchUrl =
      match.dataset.matchUrl;

    const arrow =
      match.querySelector(
        "[data-match-arrow]"
      );

    if (!matchUrl) {
      if (arrow) {
        arrow.hidden = true;
      }

      return;
    }

    if (clickable) {
      match.setAttribute(
        "href",
        matchUrl
      );

      match.removeAttribute(
        "aria-disabled"
      );

      match.removeAttribute(
        "tabindex"
      );

      match.classList.remove(
        "match-disabled"
      );

      if (arrow) {
        arrow.hidden = false;
      }

      return;
    }

    match.removeAttribute("href");

    match.setAttribute(
      "aria-disabled",
      "true"
    );

    match.setAttribute(
      "tabindex",
      "-1"
    );

    match.classList.add(
      "match-disabled"
    );

    if (arrow) {
      arrow.hidden = true;
    }
  }
      function setMatchClickable(
        match,
        clickable
      ) {
        const matchUrl =
          match.dataset.matchUrl;
          const arrow =
  match.querySelector(
    "[data-match-arrow]"
  );

        if (
          !matchUrl ||
          match.tagName !== "A"
        ) {
          return;
        }

        if (clickable) {
          match.setAttribute(
            "href",
            matchUrl
          );

          match.removeAttribute(
            "aria-disabled"
          );

          match.removeAttribute(
            "tabindex"
          );

          match.classList.remove(
            "match-disabled"
          );

          if (arrow) {
  arrow.hidden = false;
}

          return;
        }

        match.removeAttribute("href");

        match.setAttribute(
          "aria-disabled",
          "true"
        );

        match.setAttribute(
          "tabindex",
          "-1"
        );

        match.classList.add(
          "match-disabled"
        );

        if (arrow) {
  arrow.hidden = true;
}
      }

      function updateMatchStatuses() {
        const matches =
          document.querySelectorAll(
            "[data-match]"
          );

        const now = new Date();

        matches.forEach((match) => {
          const kickoffValue =
            match.dataset.kickoff;

          const rawStatus =
            (
              match.dataset.status || ""
            ).toLowerCase();

          const statusElement =
            match.querySelector(
              "[data-match-status]"
            );

          if (
            !kickoffValue ||
            !statusElement
          ) {
            return;
          }

          const kickoff =
            new Date(kickoffValue);

          const estimatedEnd =
            new Date(
              kickoff.getTime() +
              135 * 60 * 1000
            );

          const finished =
            rawStatus.includes(
              "finished"
            ) ||
            rawStatus.includes("ft");

          statusElement.classList.remove(
            "status-live",
            "status-final",
            "status-pending"
          );

          if (finished) {
            statusElement.textContent =
              "FINAL";

            statusElement.classList.add(
              "status-final"
            );

            setMatchClickable(
              match,
              true
            );

            return;
          }

          if (
            now >= kickoff &&
            now <= estimatedEnd
          ) {
            statusElement.textContent =
              "EN CURSO";

            statusElement.classList.add(
              "status-live"
            );

            setMatchClickable(
              match,
              false
            );

            return;
          }

          if (now > estimatedEnd) {
            statusElement.textContent =
              "PENDIENTE";

            statusElement.classList.add(
              "status-pending"
            );

            setMatchClickable(
              match,
              true
            );

            return;
          }

          const formatter =
            new Intl.DateTimeFormat(
              "es-ES",
              {
                hour: "2-digit",
                minute: "2-digit",
                timeZone:
                  "Europe/Madrid"
              }
            );

          statusElement.textContent =
            formatter.format(kickoff);

          setMatchClickable(
            match,
            true
          );
        });
      }

      updateMatchStatuses();

      setInterval(
        updateMatchStatuses,
        30000
      );
    </script>
  </body>
</html>

