---
import data from "../../../data/segunda.json";

export function getStaticPaths() {
  const matches = [
    ...(data.todayMatches ?? []),
    ...(data.journeyMatches ?? [])
  ];

  const uniqueMatches = new Map();

  for (const match of matches) {
    if (!match.matchSlug) {
      continue;
    }

    uniqueMatches.set(
      match.matchSlug,
      match
    );
  }

  return Array.from(
    uniqueMatches.values()
  ).map((match) => ({
    params: {
      slug: match.matchSlug
    },
    props: {
      match
    }
  }));
}

const { match } = Astro.props;

const teamStats = Object.values(
  data.teamStats ?? {}
);

const homeStats = teamStats.find(
  (item) =>
    item.slug === match.homeSlug
);

const awayStats = teamStats.find(
  (item) =>
    item.slug === match.awaySlug
);

const status = (
  match.status ?? ""
).toLowerCase();

const providerFinished =
  status.includes("finished") ||
  status.includes("ft");

const hasScore =
  match.homeScore !== null &&
  match.homeScore !== "" &&
  match.awayScore !== null &&
  match.awayScore !== "";

const kickoff =
  match.kickoffUtc
    ? new Date(match.kickoffUtc)
    : null;

const now = new Date();

const estimatedEnd =
  kickoff
    ? new Date(
        kickoff.getTime() +
        135 * 60 * 1000
      )
    : null;

const isFinished =
  providerFinished;

const isLive =
  !isFinished &&
  kickoff &&
  estimatedEnd &&
  now >= kickoff &&
  now <= estimatedEnd;

const isWaitingForFinal =
  !isFinished &&
  estimatedEnd &&
  now > estimatedEnd;

const headToHead =
  match.headToHead?.meetings ?? [];

const homeH2HWins =
  headToHead.filter((previous) => {
    if (
      previous.homeSlug ===
      match.homeSlug
    ) {
      return (
        previous.homeScore >
        previous.awayScore
      );
    }

    if (
      previous.awaySlug ===
      match.homeSlug
    ) {
      return (
        previous.awayScore >
        previous.homeScore
      );
    }

    return false;
  }).length;

const awayH2HWins =
  headToHead.filter((previous) => {
    if (
      previous.homeSlug ===
      match.awaySlug
    ) {
      return (
        previous.homeScore >
        previous.awayScore
      );
    }

    if (
      previous.awaySlug ===
      match.awaySlug
    ) {
      return (
        previous.awayScore >
        previous.homeScore
      );
    }

    return false;
  }).length;

const h2hDraws =
  headToHead.filter(
    (previous) =>
      previous.homeScore ===
      previous.awayScore
  ).length;

const formLabels = {
  W: "V",
  D: "E",
  L: "D"
};

const matchInsights = [];

if (homeStats?.last5?.played >= 3) {
  if (homeStats.last5.wins >= 3) {
    matchInsights.push(
      `${match.home} llega con ${homeStats.last5.wins} victorias en sus últimos ${homeStats.last5.played} partidos.`
    );
  }

  if (homeStats.last5.unbeatenPercentage >= 80) {
    matchInsights.push(
      `${match.home} no ha perdido en el ${homeStats.last5.unbeatenPercentage}% de sus últimos ${homeStats.last5.played} partidos.`
    );
  }
  if (homeStats?.last5?.btts >= 3) {
  matchInsights.push(
    `Hubo goles de ambos equipos en ${homeStats.last5.btts} de los últimos ${homeStats.last5.played} partidos de ${match.home}.`
  );
}
}

if (awayStats?.last5?.played >= 3) {
  if (awayStats.last5.wins >= 3) {
    matchInsights.push(
      `${match.away} suma ${awayStats.last5.wins} victorias en sus últimos ${awayStats.last5.played} partidos.`
    );
  }

  if (awayStats.last5.unbeatenPercentage >= 80) {
    matchInsights.push(
      `${match.away} no ha perdido en el ${awayStats.last5.unbeatenPercentage}% de sus últimos ${awayStats.last5.played} partidos.`
    );
  }

  if (awayStats.last5.cleanSheetPercentage >= 60) {
    matchInsights.push(
      `${match.away} dejó su portería a cero en el ${awayStats.last5.cleanSheetPercentage}% de sus últimos ${awayStats.last5.played} partidos.`
    );
  }
}

if (
  homeStats?.home?.played >= 3 &&
  homeStats.home.winPercentage >= 60
) {
  matchInsights.push(
    `${match.home} ha ganado el ${homeStats.home.winPercentage}% de sus últimos ${homeStats.home.played} partidos como local.`
  );
}

if (
  awayStats?.away?.played >= 3 &&
  awayStats.away.unbeatenPercentage >= 60
) {
  matchInsights.push(
    `${match.away} ha puntuado en el ${awayStats.away.unbeatenPercentage}% de sus últimos ${awayStats.away.played} partidos como visitante.`
  );
}

if (headToHead.length >= 2) {
  matchInsights.push(
    `En los últimos ${headToHead.length} enfrentamientos disponibles: ${match.home} ganó ${homeH2HWins}, ${match.away} ganó ${awayH2HWins} y hubo ${h2hDraws} empates.`
  );
}

const visibleInsights =
  matchInsights.slice(0, 5);

const homeForm =
  homeStats?.form ?? [];

const awayForm =
  awayStats?.form ?? [];

const formatHistoricalDate = (
  dateValue
) => {
  if (!dateValue) {
    return "";
  }

  const [year, month, day] =
    dateValue.split("-");

  return `${day}/${month}/${year}`;
};
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={`Previa, forma, tendencias y enfrentamientos directos de ${match.home} - ${match.away}.`}
    />

    <title>
      {match.home} - {match.away} | Segunda Fila
    </title>
      <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
  </head>

  <body>
    <header class="topbar">
      <div class="container header-content">
        <a href="/" class="brand">
          <div class="logo">SF</div>

          <div>
            <h1>Segunda Fila</h1>
            <p>Fútbol más allá de Primera</p>
          </div>
        </a>
      </div>
    </header>

    <main class="container page">
      <a href="/" class="back-link">
        ← Segunda División
      </a>

      <section class="match-hero panel">
        <div class="hero-top">
          <span>
            Segunda División
          </span>

          <span>
            {match.dateLabel} · {match.time}
          </span>
        </div>

        <div
          class:list={[
            "state-label",
            isFinished && "final",
            isLive && "live",
            isWaitingForFinal && "waiting",
            !isFinished &&
              !isLive &&
              !isWaitingForFinal &&
              "preview"
          ]}
          data-match-page-status
          data-kickoff={match.kickoffUtc}
          data-status={match.status ?? ""}
        >
          {
            isFinished
              ? "Final"
              : isLive
                ? "En curso"
                : isWaitingForFinal
                  ? "Pendiente de resultado final"
                  : "Previa del partido"
          }
        </div>

        <div class="scoreboard">
          <a
            href={`/segunda/equipos/${match.homeSlug}`}
            class="club"
          >
            <div class="club-logo">
              {match.home.charAt(0)}
            </div>

            <strong>
              {match.home}
            </strong>
          </a>

          <div class="score-center">
            {
              isFinished && hasScore ? (
                <div class="final-score">
                  <strong>
                    {match.homeScore}
                  </strong>

                  <span>-</span>

                  <strong>
                    {match.awayScore}
                  </strong>
                </div>
              ) : (
                <div class="versus">
                  VS
                </div>
              )
            }

            {
              !isFinished ? (
                <span class="score-note">
                  El marcador se mostrará cuando el resultado final esté confirmado
                </span>
              ) : null
            }
          </div>

          <a
            href={`/segunda/equipos/${match.awaySlug}`}
            class="club"
          >
            <div class="club-logo">
              {match.away.charAt(0)}
            </div>

            <strong>
              {match.away}
            </strong>
          </a>
        </div>
      </section>

      {
        !isFinished ? (
          <>
          {
  visibleInsights.length > 0 && (
    <section class="panel">
      <div class="panel-header">
        <div>
          <h2>Lectura del partido</h2>
          <span>Claves extraídas de los datos recientes</span>
        </div>
      </div>

      <div class="insights-list">
        {visibleInsights.map((insight) => (
          <div class="insight-row">
            <span class="insight-dot">•</span>

            <p>{insight}</p>
          </div>
        ))}
      </div>
    </section>
  )
}
            <section class="panel">
              <div class="panel-header">
                <div>
                  <h2>Cómo llegan</h2>
                  <span>Forma reciente de ambos equipos</span>
                </div>
              </div>

              <div class="form-comparison">
                <div class="form-team">
                  <div class="form-title">
                    <strong>{match.home}</strong>
                    <span>Últimos partidos</span>
                  </div>

                  <div class="form-badges">
                    {homeForm.length > 0 ? (
                      homeForm.map((result) => (
                        <span
                          class:list={[
                            "form-badge",
                            result === "W" && "win",
                            result === "D" && "draw",
                            result === "L" && "loss"
                          ]}
                        >
                          {formLabels[result] ?? result}
                        </span>
                      ))
                    ) : (
                      <span class="muted">
                        Sin datos
                      </span>
                    )}
                  </div>
                </div>

                <div class="form-team">
                  <div class="form-title">
                    <strong>{match.away}</strong>
                    <span>Últimos partidos</span>
                  </div>

                  <div class="form-badges">
                    {awayForm.length > 0 ? (
                      awayForm.map((result) => (
                        <span
                          class:list={[
                            "form-badge",
                            result === "W" && "win",
                            result === "D" && "draw",
                            result === "L" && "loss"
                          ]}
                        >
                          {formLabels[result] ?? result}
                        </span>
                      ))
                    ) : (
                      <span class="muted">
                        Sin datos
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </section>

            <section class="panel">
              <div class="panel-header">
                <div>
                  <h2>Local vs visitante</h2>
                  <span>Rendimiento reciente según condición</span>
                </div>
              </div>

              <div class="metric-grid two-teams">
                <div class="team-metrics">
                  <h3>{match.home}</h3>

                  <div class="metric">
                    <span>Partidos analizados</span>
                    <strong>
                      {homeStats?.home?.played ?? 0}
                    </strong>
                  </div>

                  <div class="metric">
                    <span>% victorias en casa</span>
                    <strong>
                      {homeStats?.home?.winPercentage ?? 0}%
                    </strong>
                  </div>

                  <div class="metric">
                    <span>Goles / partido</span>
                    <strong>
                      {homeStats?.home?.avgGoalsFor ?? 0}
                    </strong>
                  </div>

                  <div class="metric">
                    <span>% sin perder</span>
                    <strong>
                      {homeStats?.home?.unbeatenPercentage ?? 0}%
                    </strong>
                  </div>
                </div>

                <div class="team-metrics">
                  <h3>{match.away}</h3>

                  <div class="metric">
                    <span>Partidos analizados</span>
                    <strong>
                      {awayStats?.away?.played ?? 0}
                    </strong>
                  </div>

                  <div class="metric">
                    <span>% victorias fuera</span>
                    <strong>
                      {awayStats?.away?.winPercentage ?? 0}%
                    </strong>
                  </div>

                  <div class="metric">
                    <span>Goles / partido</span>
                    <strong>
                      {awayStats?.away?.avgGoalsFor ?? 0}
                    </strong>
                  </div>

                  <div class="metric">
                    <span>% sin perder</span>
                    <strong>
                      {awayStats?.away?.unbeatenPercentage ?? 0}%
                    </strong>
                  </div>
                </div>
              </div>
            </section>
          </>
        ) : (
          <section class="panel">
            <div class="panel-header">
              <div>
                <h2>Resultado final</h2>
                <span>Marcador confirmado por el proveedor</span>
              </div>
            </div>

            <div class="result-message">
              {
                hasScore
                  ? `${match.home} ${match.homeScore} - ${match.awayScore} ${match.away}`
                  : "El partido figura como finalizado, pero el marcador aún no está disponible."
              }
            </div>
          </section>
        )
      }

      {
        headToHead.length > 0 ? (
          <section class="panel">
            <div class="panel-header">
              <div>
                <h2>Enfrentamientos directos</h2>
                <span>
                  Últimos {headToHead.length} partidos disponibles
                </span>
              </div>
            </div>

            <div class="h2h-summary">
              <div>
                <span>{match.home}</span>
                <strong>{homeH2HWins}</strong>
                <small>victorias</small>
              </div>

              <div>
                <span>Empates</span>
                <strong>{h2hDraws}</strong>
                <small>partidos</small>
              </div>

              <div>
                <span>{match.away}</span>
                <strong>{awayH2HWins}</strong>
                <small>victorias</small>
              </div>
            </div>

            <div class="h2h-list">
              {headToHead.map((previous) => (
                <div class="h2h-row">
                  <span class="h2h-date">
                    {formatHistoricalDate(previous.date)}
                  </span>

                  <div class="h2h-match">
                    <span>{previous.home}</span>

                    <strong>
                      {previous.homeScore}
                      {" - "}
                      {previous.awayScore}
                    </strong>

                    <span>{previous.away}</span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ) : null
      }
    </main>

    <script is:inline>
      function updateMatchPageStatus() {
        const element =
          document.querySelector(
            "[data-match-page-status]"
          );

        if (!element) {
          return;
        }

        const kickoffValue =
          element.dataset.kickoff;

        const rawStatus =
          (
            element.dataset.status || ""
          ).toLowerCase();

        if (!kickoffValue) {
          return;
        }

        const kickoff =
          new Date(kickoffValue);

        const estimatedEnd =
          new Date(
            kickoff.getTime() +
            135 * 60 * 1000
          );

        const now = new Date();

        const finished =
          rawStatus.includes(
            "finished"
          ) ||
          rawStatus.includes("ft");

        element.classList.remove(
          "preview",
          "live",
          "waiting",
          "final"
        );

        if (finished) {
          element.textContent =
            "Final";

          element.classList.add(
            "final"
          );

          return;
        }

        if (
          now >= kickoff &&
          now <= estimatedEnd
        ) {
          element.textContent =
            "En curso";

          element.classList.add(
            "live"
          );

          return;
        }

        if (now > estimatedEnd) {
          element.textContent =
            "Pendiente de resultado final";

          element.classList.add(
            "waiting"
          );

          return;
        }

        element.textContent =
          "Previa del partido";

        element.classList.add(
          "preview"
        );
      }

      updateMatchPageStatus();

      setInterval(
        updateMatchPageStatus,
        30000
      );
    </script>
  
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="site-footer-main">
          <a href="/" class="site-footer-brand">
            <span class="site-footer-logo">SF</span>

            <div class="site-footer-identity">
              <strong>Segunda Fila</strong>
              <span>Fútbol más allá de Primera</span>
            </div>
          </a>

          <p class="site-footer-description">
            Estadísticas, tendencias, partidos e historias
            del fútbol más allá de Primera División.
          </p>
        </div>

        <div class="site-footer-bottom">
          <span>© 2026 Segunda Fila</span>
          <span class="site-footer-tagline">
            El fútbol también se juega en segunda fila.
          </span>
        </div>
      </div>
    </footer>

  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #f3f4f6;
    color-scheme: light;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f3f4f6;
    color: #202124;
    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .container {
    width: min(900px, 94%);
    margin: 0 auto;
  }

  .page {
    padding: 24px 0 60px;
  }

  .topbar {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .header-content {
    padding: 18px 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .logo {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #111827;
    color: #ffffff;
    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: 20px;
  }

  .brand p {
    margin: 3px 0 0;
    color: #6b7280;
    font-size: 13px;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 16px;
    color: #6b7280;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
  }

  .back-link:hover {
    color: #111827;
  }

  .panel {
    margin-bottom: 20px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
  }

  .panel-header {
    padding: 18px 20px;
    border-bottom: 1px solid #eeeeee;
  }

  .panel-header h2 {
    margin: 0;
    font-size: 16px;
  }

  .panel-header span {
    display: block;
    margin-top: 4px;
    color: #9ca3af;
    font-size: 12px;
  }

  .match-hero {
    padding: 20px;
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: #6b7280;
    font-size: 12px;
  }

  .state-label {
    width: fit-content;
    margin: 18px auto 0;
    padding: 6px 10px;
    border-radius: 999px;
    background: #f3f4f6;
    color: #6b7280;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .state-label.live {
    background: #fef2f2;
    color: #dc2626;
  }

  .state-label.final {
    background: #f3f4f6;
    color: #4b5563;
  }

  .state-label.waiting {
    background: #fffbeb;
    color: #9a6700;
  }

  .scoreboard {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      180px
      minmax(0, 1fr);
    gap: 20px;
    align-items: center;
    padding: 30px 0 12px;
  }

  .club {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .club-logo {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #f3f4f6;
    color: #4b5563;
    font-size: 20px;
    font-weight: 800;
  }

  .club strong {
    font-size: 16px;
  }

  .score-center {
    text-align: center;
  }

  .final-score {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    color: #111827;
  }

  .final-score strong {
    font-size: 34px;
  }

  .final-score span {
    color: #9ca3af;
    font-size: 20px;
  }

  .versus {
    color: #9ca3af;
    font-size: 15px;
    font-weight: 800;
  }

  .score-note {
    display: block;
    max-width: 170px;
    margin: 8px auto 0;
    color: #9ca3af;
    font-size: 10px;
    line-height: 1.4;
  }

  .form-comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #eeeeee;
  }

  .form-team {
    padding: 20px;
    background: #ffffff;
  }

  .form-title {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 14px;
  }

  .form-title span {
    color: #9ca3af;
    font-size: 11px;
  }

  .form-badges {
    display: flex;
    gap: 7px;
  }

  .form-badge {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 7px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
  }

  .form-badge.win {
    background: #16a34a;
  }

  .form-badge.draw {
    background: #9ca3af;
  }

  .form-badge.loss {
    background: #dc2626;
  }

  .muted {
    color: #9ca3af;
    font-size: 12px;
  }

  .metric-grid.two-teams {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #eeeeee;
  }

  .team-metrics {
    padding: 20px;
    background: #ffffff;
  }

  .team-metrics h3 {
    margin: 0 0 14px;
    font-size: 14px;
  }

  .metric {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid #f0f0f0;
    font-size: 12px;
  }

  .metric span {
    color: #6b7280;
  }

  .result-message {
    padding: 24px 20px;
    font-size: 14px;
    font-weight: 700;
  }

  .h2h-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #eeeeee;
  }

  .h2h-summary > div {
    padding: 18px;
    background: #ffffff;
    text-align: center;
  }

  .h2h-summary span,
  .h2h-summary small {
    display: block;
    color: #6b7280;
    font-size: 11px;
  }

  .h2h-summary strong {
    display: block;
    margin: 6px 0 3px;
    font-size: 24px;
  }

  .h2h-row {
    display: grid;
    grid-template-columns: 90px 1fr;
