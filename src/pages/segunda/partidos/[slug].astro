<script is:inline>
  function updateMatchPageStatus() {
    const element =
      document.querySelector(
        "[data-match-page-status]"
      );

    if (!element) {
      return;
    }

    const kickoffValue =
      element.dataset.kickoff;

    const rawStatus =
      (
        element.dataset.status || ""
      ).toLowerCase();

    if (!kickoffValue) {
      return;
    }

    const kickoff =
      new Date(kickoffValue);

    const estimatedEnd =
      new Date(
        kickoff.getTime() +
        135 * 60 * 1000
      );

    const now = new Date();

    const finished =
      rawStatus.includes("finished") ||
      rawStatus.includes("ft");

    element.classList.remove(
      "preview",
      "live",
      "waiting",
      "final"
    );

    if (finished) {
      element.textContent =
        "Final";

      element.classList.add(
        "final"
      );

      return;
    }

    if (
      now >= kickoff &&
      now <= estimatedEnd
    ) {
      element.textContent =
        "En curso";

      element.classList.add(
        "live"
      );

      return;
    }

    if (now > estimatedEnd) {
      element.textContent =
        "Pendiente de resultado final";

      element.classList.add(
        "waiting"
      );

      return;
    }

    element.textContent =
      "Previa del partido";

    element.classList.add(
      "preview"
    );
  }

  updateMatchPageStatus();

  setInterval(
    updateMatchPageStatus,
    30000
  );
</script>
