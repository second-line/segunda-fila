---
import data from "../../../data/segunda.json";

export function getStaticPaths() {
  const matches = [
    ...(data.todayMatches ?? []),
    ...(data.journeyMatches ?? [])
  ];

  const uniqueMatches = Array.from(
    new Map(
      matches
        .filter((match) => match.matchSlug)
        .map((match) => [
          match.matchSlug,
          match
        ])
    ).values()
  );

  return uniqueMatches.map((match) => ({
    params: {
      slug: match.matchSlug
    },
    props: {
      match
    }
  }));
}

const { match } = Astro.props;

const allTeamStats = Object.values(
  data.teamStats ?? {}
);

const homeStats = allTeamStats.find(
  (team) =>
    team.slug === match.homeSlug
);

const awayStats = allTeamStats.find(
  (team) =>
    team.slug === match.awaySlug
);

const homeLast5 =
  homeStats?.last5;

const awayLast5 =
  awayStats?.last5;

const homeHomeStats =
  homeStats?.home;

const awayAwayStats =
  awayStats?.away;

const homeForm =
  homeStats?.form ?? [];

const awayForm =
  awayStats?.form ?? [];

const headToHead =
  match.headToHead?.meetings ?? [];

const formLabels = {
  W: "V",
  D: "E",
  L: "D"
};


const status = (
  match.status ?? ""
).toLowerCase();

const hasScore =
  match.homeScore !== null &&
  match.homeScore !== "" &&
  match.awayScore !== null &&
  match.awayScore !== "";

const kickoff =
  match.kickoffUtc
    ? new Date(match.kickoffUtc)
    : null;

const now = new Date();

const estimatedEnd =
  kickoff
    ? new Date(
        kickoff.getTime() +
        135 * 60 * 1000
      )
    : null;

const isFinished =
  providerFinished;

const providerFinished =
  status.includes("finished") ||
  status.includes("ft");

const isFinished =
  providerFinished;

const isLive =
  !isFinished &&
  kickoff &&
  estimatedEnd &&
  now >= kickoff &&
  now <= estimatedEnd;

const isWaitingForFinal =
  !isFinished &&
  estimatedEnd &&
  now > estimatedEnd;

const isLive =
  !isFinished &&
  kickoff &&
  estimatedEnd &&
  now >= kickoff &&
  now <= estimatedEnd;

const isWaitingForFinal =
  !isFinished &&
  estimatedEnd &&
  now > estimatedEnd;


const formatMatchDate = (date) => {
  if (!date) {
    return "";
  }

  const value = new Date(
    `${date}T12:00:00`
  );

  return new Intl.DateTimeFormat(
    "es-ES",
    {
      weekday: "long",
      day: "numeric",
      month: "long"
    }
  ).format(value);
};


const formatShortDate = (date) => {
  if (!date) {
    return "";
  }

  const value = new Date(
    `${date}T12:00:00`
  );

  return new Intl.DateTimeFormat(
    "es-ES",
    {
      day: "2-digit",
      month: "2-digit",
      year: "numeric"
    }
  ).format(value);
};


const historyContainsMatch = (
  teamStats,
  opponent,
  date
) => {
  const matches =
    teamStats?.recentMatches ?? [];

  return matches.some((item) => {
    const itemDate =
      item.date?.slice(0, 10);

    return (
      itemDate === date &&
      item.opponent === opponent
    );
  });
};


const homeStatsUpdated =
  historyContainsMatch(
    homeStats,
    match.away,
    match.date
  );

const awayStatsUpdated =
  historyContainsMatch(
    awayStats,
    match.home,
    match.date
  );

const statsUpdated =
  isFinished &&
  homeStatsUpdated &&
  awayStatsUpdated;


/* --------------------------------
   RESUMEN H2H
-------------------------------- */

let homeH2HWins = 0;
let awayH2HWins = 0;
let h2hDraws = 0;

for (const previous of headToHead) {
  const previousHomeSlug =
    previous.homeSlug;

  const previousAwaySlug =
    previous.awaySlug;

  if (
    previous.homeScore ===
    previous.awayScore
  ) {
    h2hDraws += 1;
    continue;
  }

  const winnerSlug =
    previous.homeScore >
    previous.awayScore
      ? previousHomeSlug
      : previousAwaySlug;

  if (
    winnerSlug ===
    match.homeSlug
  ) {
    homeH2HWins += 1;
  }

  if (
    winnerSlug ===
    match.awaySlug
  ) {
    awayH2HWins += 1;
  }
}


/* --------------------------------
   PREVIA
-------------------------------- */

const previewReads = [];

if (
  !isFinished &&
  !isLive &&
  !isWaitingForFinal &&
  homeStats &&
  awayStats
) {
  if (
    homeStats.winStreak >= 3
  ) {
    previewReads.push(
      `${match.home} llega con ${homeStats.winStreak} victorias consecutivas`
    );

  } else if (
    homeStats.unbeatenStreak >= 4
  ) {
    previewReads.push(
      `${match.home} encadena ${homeStats.unbeatenStreak} partidos sin perder`
    );

  } else if (homeLast5) {
    previewReads.push(
      `${match.home} ha sumado ${homeLast5.points} de los últimos ${homeLast5.played * 3} puntos`
    );
  }


  if (
    awayStats.winStreak >= 3
  ) {
    previewReads.push(
      `${match.away} llega con ${awayStats.winStreak} victorias consecutivas`
    );

  } else if (
    awayStats.unbeatenStreak >= 4
  ) {
    previewReads.push(
      `${match.away} lleva ${awayStats.unbeatenStreak} partidos sin perder`
    );

  } else if (awayLast5) {
    previewReads.push(
      `${match.away} ha sumado ${awayLast5.points} de los últimos ${awayLast5.played * 3} puntos`
    );
  }


  if (
    homeHomeStats &&
    homeHomeStats.wins >= 3
  ) {
    previewReads.push(
      `${match.home} ha ganado ${homeHomeStats.wins} de sus últimos ${homeHomeStats.played} partidos en casa`
    );

  } else if (
    awayAwayStats &&
    awayAwayStats.wins >= 3
  ) {
    previewReads.push(
      `${match.away} ha ganado ${awayAwayStats.wins} de sus últimos ${awayAwayStats.played} partidos como visitante`
    );
  }


  if (
    homeLast5 &&
    awayLast5
  ) {
    previewReads.push(
      `En los últimos cinco partidos promedian ${homeLast5.avgGoalsFor} y ${awayLast5.avgGoalsFor} goles por encuentro, respectivamente`
    );
  }
}


/* --------------------------------
   POSTPARTIDO
-------------------------------- */

let resultSummary = "";

if (
  isFinished &&
  hasScore
) {
  if (
    match.homeScore >
    match.awayScore
  ) {
    resultSummary =
      `${match.home} se impuso ${match.homeScore}-${match.awayScore} a ${match.away}.`;

  } else if (
    match.awayScore >
    match.homeScore
  ) {
    resultSummary =
      `${match.away} se llevó el partido por ${match.awayScore}-${match.homeScore} ante ${match.home}.`;

  } else {
    resultSummary =
      `${match.home} y ${match.away} empataron ${match.homeScore}-${match.awayScore}.`;
  }
}


const postMatchReads = [];

if (statsUpdated) {
  if (
    homeStats.winStreak >= 2
  ) {
    postMatchReads.push(
      `${match.home} encadena ahora ${homeStats.winStreak} victorias consecutivas`
    );

  } else if (
    homeStats.unbeatenStreak >= 3
  ) {
    postMatchReads.push(
      `${match.home} amplía a ${homeStats.unbeatenStreak} su racha de partidos sin perder`
    );

  } else if (
    homeStats.losingStreak >= 2
  ) {
    postMatchReads.push(
      `${match.home} suma ${homeStats.losingStreak} derrotas consecutivas`
    );

  } else if (
    homeStats.winlessStreak >= 3
  ) {
    postMatchReads.push(
      `${match.home} lleva ya ${homeStats.winlessStreak} partidos sin ganar`
    );
  }


  if (
    awayStats.winStreak >= 2
  ) {
    postMatchReads.push(
      `${match.away} encadena ahora ${awayStats.winStreak} victorias consecutivas`
    );

  } else if (
    awayStats.unbeatenStreak >= 3
  ) {
    postMatchReads.push(
      `${match.away} amplía a ${awayStats.unbeatenStreak} su racha de partidos sin perder`
    );

  } else if (
    awayStats.losingStreak >= 2
  ) {
    postMatchReads.push(
      `${match.away} suma ${awayStats.losingStreak} derrotas consecutivas`
    );

  } else if (
    awayStats.winlessStreak >= 3
  ) {
    postMatchReads.push(
      `${match.away} lleva ya ${awayStats.winlessStreak} partidos sin ganar`
    );
  }


  if (
    homeStats.scoringStreak >= 3
  ) {
    postMatchReads.push(
      `${match.home} ha marcado en sus últimos ${homeStats.scoringStreak} partidos`
    );
  }


  if (
    awayStats.scoringStreak >= 3
  ) {
    postMatchReads.push(
      `${match.away} ha marcado en sus últimos ${awayStats.scoringStreak} partidos`
    );
  }
}


const pageTitle =
  isFinished
    ? `${match.home} ${match.homeScore ?? ""} - ${match.awayScore ?? ""} ${match.away}`
    : `${match.home} - ${match.away}`;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={
        isFinished
          ? `Resultado, forma y tendencias de ${match.home} - ${match.away} en Segunda División.`
          : `Previa, forma, estadísticas y enfrentamientos entre ${match.home} y ${match.away}.`
      }
    />

    <title>
      {pageTitle} | Segunda Fila
    </title>
  </head>

  <body>

    <header class="topbar">
      <div class="container header-content">

        <a
          href="/"
          class="brand"
        >
          <div class="logo">
            SF
          </div>

          <div>
            <h1>
              Segunda Fila
            </h1>

            <p>
              Fútbol más allá de Primera
            </p>
          </div>
        </a>

      </div>
    </header>


    <main class="container page">

      <a
        href="/"
        class="back-link"
      >
        ← Segunda División
      </a>


      <!-- CABECERA -->

      <section class="match-hero">

        <div class="match-meta">

          <span>
            Segunda División
          </span>

          <strong>
            {formatMatchDate(match.date)}
          </strong>

          {
            !isFinished &&
            !isLive &&
            !isWaitingForFinal && (
              <span>
                {match.time}
              </span>
            )
          }

        </div>


        <div class="match-teams">

          <a
            href={`/segunda/equipos/${match.homeSlug}`}
            class="hero-team"
          >

            <div class="team-avatar">
              {match.home.charAt(0)}
            </div>

            <strong>
              {match.home}
            </strong>

          </a>


          <div class="match-center">

            {
              isFinished &&
              hasScore ? (
                <div class="final-score">

                  <strong>
                    {match.homeScore}
                  </strong>

                  <span>
                    -
                  </span>

                  <strong>
                    {match.awayScore}
                  </strong>

                </div>
              ) : (
                <div class="versus">
                  VS
                </div>
              )
            }

          </div>


          <a
            href={`/segunda/equipos/${match.awaySlug}`}
            class="hero-team"
          >

            <div class="team-avatar">
              {match.away.charAt(0)}
            </div>

            <strong>
              {match.away}
            </strong>

          </a>

        </div>
        <div
  class:list={[
    "state-label",
    isFinished && "final",
    isLive && "live",
    isWaitingForFinal && "waiting",
    !isFinished &&
      !isLive &&
      !isWaitingForFinal &&
      "preview"
  ]}
  data-match-page-status
  data-kickoff={match.kickoffUtc}
  data-status={match.status ?? ""}
>
  {
    isFinished
      ? "Final"
      : isLive
        ? "En curso"
        : isWaitingForFinal
          ? "Pendiente de resultado final"
          : "Previa del partido"
  }
</div>
      </section>


      <!-- EN CURSO -->

      {
        isLive && (
          <section class="panel info-panel">

            <strong>
              Partido en curso
            </strong>

            <p>
              La página se actualizará con el
              resultado y las nuevas rachas cuando
              termine el encuentro y los datos
              estén disponibles.
            </p>

          </section>
        )
      }


      <!-- ESPERANDO RESULTADO -->

      {
        isWaitingForFinal && (
          <section class="panel info-panel">

            <strong>
              Esperando actualización del resultado
            </strong>

            <p>
              El horario estimado del partido ya ha
              terminado, pero todavía no tenemos un
              resultado final confirmado.
            </p>

          </section>
        )
      }


      <!-- PREVIA -->

      {
        !isFinished &&
        !isLive &&
        !isWaitingForFinal && (
          <>

            {
              previewReads.length > 0 && (
                <section class="panel">

                  <div class="panel-header">
                    <div>

                      <h2>
                        Claves del partido
                      </h2>

                      <span>
                        Cómo llegan los dos equipos
                      </span>

                    </div>
                  </div>


                  <div class="quick-list">

                    {
                      previewReads
                        .slice(0, 4)
                        .map((item) => (
                          <div class="quick-item">

                            <span
                              class="quick-dot"
                            ></span>

                            <p>
                              {item}
                            </p>

                          </div>
                        ))
                    }

                  </div>

                </section>
              )
            }


            {
              homeStats &&
              awayStats && (
                <section class="panel">

                  <div class="panel-header">
                    <div>

                      <h2>
                        Cómo llegan
                      </h2>

                      <span>
                        Últimos 5 partidos
                      </span>

                    </div>
                  </div>


                  <div class="comparison-head">

                    <strong>
                      {match.home}
                    </strong>

                    <span></span>

                    <strong>
                      {match.away}
                    </strong>

                  </div>


                  <div class="form-comparison">

                    <div class="form-list">

                      {
                        homeForm.map(
                          (result) => (
                            <span
                              class:list={[
                                "form-item",
                                result === "W" &&
                                  "win",
                                result === "D" &&
                                  "draw",
                                result === "L" &&
                                  "loss"
                              ]}
                            >
                              {
                                formLabels[
                                  result
                                ]
                              }
                            </span>
                          )
                        )
                      }

                    </div>


                    <span class="comparison-label">
                      Forma
                    </span>


                    <div class="form-list">

                      {
                        awayForm.map(
                          (result) => (
                            <span
                              class:list={[
                                "form-item",
                                result === "W" &&
                                  "win",
                                result === "D" &&
                                  "draw",
                                result === "L" &&
                                  "loss"
                              ]}
                            >
                              {
                                formLabels[
                                  result
                                ]
                              }
                            </span>
                          )
                        )
                      }

                    </div>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeLast5?.points ??
                        "-"
                      }
                    </strong>

                    <span>
                      Puntos
                    </span>

                    <strong>
                      {
                        awayLast5?.points ??
                        "-"
                      }
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeLast5?.avgGoalsFor ??
                        "-"
                      }
                    </strong>

                    <span>
                      Goles / partido
                    </span>

                    <strong>
                      {
                        awayLast5?.avgGoalsFor ??
                        "-"
                      }
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeLast5?.avgGoalsAgainst ??
                        "-"
                      }
                    </strong>

                    <span>
                      Encajados / partido
                    </span>

                    <strong>
                      {
                        awayLast5?.avgGoalsAgainst ??
                        "-"
                      }
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeLast5?.unbeatenPercentage ??
                        "-"
                      }%
                    </strong>

                    <span>
                      Sin perder
                    </span>

                    <strong>
                      {
                        awayLast5?.unbeatenPercentage ??
                        "-"
                      }%
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeLast5?.over25Percentage ??
                        "-"
                      }%
                    </strong>

                    <span>
                      Más de 2,5
                    </span>

                    <strong>
                      {
                        awayLast5?.over25Percentage ??
                        "-"
                      }%
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeLast5?.bttsPercentage ??
                        "-"
                      }%
                    </strong>

                    <span>
                      Ambos marcan
                    </span>

                    <strong>
                      {
                        awayLast5?.bttsPercentage ??
                        "-"
                      }%
                    </strong>

                  </div>

                </section>
              )
            }


            {
              homeHomeStats &&
              awayAwayStats && (
                <section class="panel">

                  <div class="panel-header">
                    <div>

                      <h2>
                        Local vs visitante
                      </h2>

                      <span>
                        Rendimiento en la condición
                        de este partido
                      </span>

                    </div>
                  </div>


                  <div class="comparison-head">

                    <strong>
                      {match.home} en casa
                    </strong>

                    <span></span>

                    <strong>
                      {match.away} fuera
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {homeHomeStats.wins}
                    </strong>

                    <span>
                      Victorias
                    </span>

                    <strong>
                      {awayAwayStats.wins}
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeHomeStats
                          .avgGoalsFor
                      }
                    </strong>

                    <span>
                      Goles / partido
                    </span>

                    <strong>
                      {
                        awayAwayStats
                          .avgGoalsFor
                      }
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeHomeStats
                          .avgGoalsAgainst
                      }
                    </strong>

                    <span>
                      Encajados
                    </span>

                    <strong>
                      {
                        awayAwayStats
                          .avgGoalsAgainst
                      }
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeHomeStats
                          .unbeatenPercentage
                      }%
                    </strong>

                    <span>
                      Sin perder
                    </span>

                    <strong>
                      {
                        awayAwayStats
                          .unbeatenPercentage
                      }%
                    </strong>

                  </div>

                </section>
              )
            }

          </>
        )
      }


      <!-- POSTPARTIDO -->

      {
        isFinished && (
          <>

            <section class="panel">

              <div class="panel-header">
                <div>

                  <h2>
                    Resumen del partido
                  </h2>

                  <span>
                    Resultado final
                  </span>

                </div>
              </div>


              <div class="match-summary">

                {
                  resultSummary ? (
                    <p>
                      {resultSummary}
                    </p>
                  ) : (
                    <p>
                      El partido ha finalizado.
                    </p>
                  )
                }

                {
                  statsUpdated &&
                  postMatchReads.length > 0 && (
                    <p>
                      {
                        postMatchReads[0]
                      }.
                    </p>
                  )
                }

              </div>

            </section>


            {
              !statsUpdated && (
                <section class="panel update-pending">

                  <strong>
                    Estadísticas en actualización
                  </strong>

                  <p>
                    Ya tenemos el resultado final,
                    pero las nuevas rachas y
                    estadísticas todavía no se han
                    incorporado a los datos de la
                    competición.
                  </p>

                  <span>
                    Se actualizarán automáticamente
                    cuando el proveedor incorpore
                    el partido.
                  </span>

                </section>
              )
            }


            {
              statsUpdated &&
              postMatchReads.length > 0 && (
                <section class="panel">

                  <div class="panel-header">
                    <div>

                      <h2>
                        Después del partido
                      </h2>

                      <span>
                        Cómo quedan las rachas
                      </span>

                    </div>
                  </div>


                  <div class="quick-list">

                    {
                      postMatchReads
                        .slice(0, 4)
                        .map((item) => (
                          <div class="quick-item">

                            <span
                              class="quick-dot"
                            ></span>

                            <p>
                              {item}
                            </p>

                          </div>
                        ))
                    }

                  </div>

                </section>
              )
            }


            {
              statsUpdated &&
              homeStats &&
              awayStats && (
                <section class="panel">

                  <div class="panel-header">
                    <div>

                      <h2>
                        Forma actualizada
                      </h2>

                      <span>
                        Últimos 5 partidos incluyendo
                        este resultado
                      </span>

                    </div>
                  </div>


                  <div class="comparison-head">

                    <strong>
                      {match.home}
                    </strong>

                    <span></span>

                    <strong>
                      {match.away}
                    </strong>

                  </div>


                  <div class="form-comparison">

                    <div class="form-list">

                      {
                        homeForm.map(
                          (result) => (
                            <span
                              class:list={[
                                "form-item",
                                result === "W" &&
                                  "win",
                                result === "D" &&
                                  "draw",
                                result === "L" &&
                                  "loss"
                              ]}
                            >
                              {
                                formLabels[
                                  result
                                ]
                              }
                            </span>
                          )
                        )
                      }

                    </div>

                    <span class="comparison-label">
                      Forma
                    </span>

                    <div class="form-list">

                      {
                        awayForm.map(
                          (result) => (
                            <span
                              class:list={[
                                "form-item",
                                result === "W" &&
                                  "win",
                                result === "D" &&
                                  "draw",
                                result === "L" &&
                                  "loss"
                              ]}
                            >
                              {
                                formLabels[
                                  result
                                ]
                              }
                            </span>
                          )
                        )
                      }

                    </div>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeLast5?.points ??
                        "-"
                      }
                    </strong>

                    <span>
                      Puntos últimos 5
                    </span>

                    <strong>
                      {
                        awayLast5?.points ??
                        "-"
                      }
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {homeStats.winStreak}
                    </strong>

                    <span>
                      Victorias seguidas
                    </span>

                    <strong>
                      {awayStats.winStreak}
                    </strong>

                  </div>


                  <div class="comparison-row">

                    <strong>
                      {
                        homeStats.unbeatenStreak
                      }
                    </strong>

                    <span>
                      Sin perder
                    </span>

                    <strong>
                      {
                        awayStats.unbeatenStreak
                      }
