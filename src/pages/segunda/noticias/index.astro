<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>
      Actualidad de Segunda División | Segunda Fila
    </title>

    <meta
      name="description"
      content="Noticias, protagonistas e historias de Segunda División en Segunda Fila."
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <link
      rel="canonical"
      href="https://segunda-fila.pages.dev/segunda/noticias"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="Segunda Fila"
    />

    <meta
      property="og:title"
      content="Actualidad de Segunda División | Segunda Fila"
    />

    <meta
      property="og:description"
      content="Noticias, protagonistas e historias de Segunda División."
    />

    <meta
      property="og:url"
      content="https://segunda-fila.pages.dev/segunda/noticias"
    />
  </head>

  <body>
    <main class="page">

      <a
        href="/"
        class="back-home"
      >
        ←
      </a>

      <header class="news-header">
        <div>
          <span class="eyebrow">
            Segunda División
          </span>

          <h1>Actualidad</h1>

          <p>
            Noticias, protagonistas e historias
            alrededor de Segunda.
          </p>
        </div>
      </header>

      <nav class="categories">
        <button
          type="button"
          class="category-chip active"
          data-filter=""
        >
          Todas
        </button>

        {categories.map((category) => (
          <button
            type="button"
            class="category-chip"
            data-filter={category.slug}
          >
            {category.label}
          </button>
        ))}
      </nav>

      {
        articles.length > 0 ? (
          <section class="articles">

            {articles.map((article) => (
              <a
                href={`/segunda/noticias/${article.slug}`}
                class="article-card" data-category={article.category}
              >
                {
                  article.image && (
                    <div class="article-image">
                      <img
                        src={article.image}
                        alt={
                          article.imageAlt ??
                          article.title
                        }
                      />
                    </div>
                  )
                }

                <div class="article-content">

                  <div class="article-meta">
                    <span class="category">
                      {
                        categoryLabel(
                          article.category
                        )
                      }
                    </span>

                    <span>
                      {formatDate(article.date)}
                    </span>
                  </div>

                  <h2>
                    {article.title}
                  </h2>

                  {
                    article.description && (
                      <p>
                        {article.description}
                      </p>
                    )
                  }

                  {
                    article.team && (
                      <span class="team">
                        {article.team}
                      </span>
                    )
                  }

                </div>
              </a>
            ))}

          </section>

          <nav
            class="news-pagination"
            data-pagination
            aria-label="Paginación de noticias"
          ></nav>
        ) : (
          <div class="empty">
            Todavía no hay noticias publicadas.
          </div>
        )
      }

    </main>
  
<script>
  const PAGE_SIZE = 6;

  const chips = Array.from(
    document.querySelectorAll(".category-chip")
  );

  const cards = Array.from(
    document.querySelectorAll(".article-card[data-category]")
  );

  const pagination =
    document.querySelector("[data-pagination]");

  let activeFilter = "";
  let currentPage = 1;

  function getFilteredCards() {
    return cards.filter((card) => {
      const category =
        card.dataset.category ?? "";

      return (
        !activeFilter ||
        category === activeFilter
      );
    });
  }

  function renderPagination(totalPages) {
    if (!pagination) {
      return;
    }

    pagination.innerHTML = "";

    if (totalPages <= 1) {
      pagination.hidden = true;
      return;
    }

    pagination.hidden = false;

    const createButton = (
      label,
      page,
      {
        active = false,
        disabled = false,
        ariaLabel = ""
      } = {}
    ) => {
      const button =
        document.createElement("button");

      button.type = "button";
      button.className = "pagination-button";

      if (active) {
        button.classList.add("active");
        button.setAttribute(
          "aria-current",
          "page"
        );
      }

      button.disabled = disabled;
      button.textContent = label;

      if (ariaLabel) {
        button.setAttribute(
          "aria-label",
          ariaLabel
        );
      }

      button.addEventListener(
        "click",
        () => {
          currentPage = page;
          renderArticles();
        }
      );

      return button;
    };

    pagination.appendChild(
      createButton(
        "←",
        currentPage - 1,
        {
          disabled: currentPage === 1,
          ariaLabel: "Página anterior"
        }
      )
    );

    for (
      let page = 1;
      page <= totalPages;
      page++
    ) {
      pagination.appendChild(
        createButton(
          String(page),
          page,
          {
            active:
              page === currentPage,
            ariaLabel:
              `Ir a la página ${page}`
          }
        )
      );
    }

    pagination.appendChild(
      createButton(
        "→",
        currentPage + 1,
        {
          disabled:
            currentPage === totalPages,
          ariaLabel: "Página siguiente"
        }
      )
    );
  }

  function renderArticles() {
    const filteredCards =
      getFilteredCards();

    const totalPages =
      Math.max(
        1,
        Math.ceil(
          filteredCards.length /
          PAGE_SIZE
        )
      );

    if (currentPage > totalPages) {
      currentPage = totalPages;
    }

    cards.forEach((card) => {
      card.style.display = "none";
    });

    const start =
      (currentPage - 1) *
      PAGE_SIZE;

    const end =
      start + PAGE_SIZE;

    filteredCards
      .slice(start, end)
      .forEach((card) => {
        card.style.display = "";
      });

    renderPagination(totalPages);
  }

  chips.forEach((chip) => {
    chip.addEventListener(
      "click",
      (event) => {
        event.preventDefault();

        activeFilter =
          chip.dataset.filter ?? "";

        currentPage = 1;

        chips.forEach((item) => {
          item.classList.remove(
            "active"
          );
        });

        chip.classList.add("active");

        renderArticles();
      }
    );
  });

  renderArticles();
</script>


