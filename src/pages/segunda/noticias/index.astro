---
const modules = import.meta.glob(
  "../../../content/noticias/*.md",
  {
    eager: true
  }
);

const articles = Object.entries(modules)
  .map(([path, module]) => {
    const slug = path
      .split("/")
      .pop()
      ?.replace(".md", "");

    return {
      slug,
      ...(module.frontmatter ?? {})
    };
  })
  .sort(
    (a, b) =>
      new Date(b.date).getTime() -
      new Date(a.date).getTime()
  );

const categories = [
  {
    slug: "actualidad",
    label: "Actualidad"
  },
  {
    slug: "en-el-foco",
    label: "En el foco"
  },
  {
    slug: "que-fue-de",
    label: "Qué fue de…"
  }
];

function categoryLabel(category) {
  return (
    categories.find(
      (item) => item.slug === category
    )?.label ?? category
  );
}

function formatDate(date) {
  return new Intl.DateTimeFormat(
    "es-ES",
    {
      day: "numeric",
      month: "short",
      year: "numeric"
    }
  ).format(new Date(date));
}

const newsModules = import.meta.glob(
  "../content/noticias/*.md",
  {
    eager: true
  }
);

const latestNews = Object.entries(newsModules)
  .map(([path, module]) => {
    const slug = path
      .split("/")
      .pop()
      ?.replace(".md", "");

    return {
      slug,
      ...(module.frontmatter ?? {})
    };
  })
  .sort(
    (a, b) =>
      new Date(b.date).getTime() -
      new Date(a.date).getTime()
  )
  .slice(0, 3);

function formatNewsDate(date) {
  return new Intl.DateTimeFormat(
    "es-ES",
    {
      day: "numeric",
      month: "short"
    }
  ).format(
    new Date(date)
  );
}
