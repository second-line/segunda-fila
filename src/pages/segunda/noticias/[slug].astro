---
export function getStaticPaths() {
  const modules = import.meta.glob(
    "../../../content/noticias/*.md",
    {
      eager: true
    }
  );

  return Object.entries(modules).map(
    ([path, module]) => {
      const slug = path
        .split("/")
        .pop()
        ?.replace(".md", "");

      return {
        params: {
          slug
        },

        props: {
          article: {
            slug,
            frontmatter:
              module.frontmatter ?? {},
            Content:
              module.Content
          }
        }
      };
    }
  );
}

const {
  article
} = Astro.props;

const {
  frontmatter,
  Content
} = article;

const categories = {
  actualidad: "Actualidad",
  "en-el-foco": "En el foco",
  "que-fue-de": "Qué fue de…"
};

const categoryLabel =
  categories[
    frontmatter.category
  ] ??
  frontmatter.category;

function formatDate(date) {
  return new Intl.DateTimeFormat(
    "es-ES",
    {
      day: "numeric",
      month: "long",
      year: "numeric"
    }
  ).format(
    new Date(date)
  );
}
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>
      {frontmatter.title} | Segunda Fila
    </title>

    <meta
      name="description"
      content={frontmatter.description}
    />
  </head>

  <body>

    <main class="page">

      <a
        href="/"
        class="back-link"
      >
        ← Segunda División
      </a>

      <article class="article">

        <header class="article-header">

          <div class="article-meta">

            <span class="category">
              {categoryLabel}
            </span>

            <span>
              {formatDate(frontmatter.date)}
            </span>

          </div>

          <h1>
            {frontmatter.title}
          </h1>

          {
            frontmatter.description && (
              <p class="description">
                {frontmatter.description}
              </p>
            )
          }

          <div class="article-info">

            <span>
              Por {
                frontmatter.author ??
                "Segunda Fila"
              }
            </span>

            {
              frontmatter.team && (
                <>
                  <span>·</span>

                  <a
                    href={
                      `/segunda/equipos/${frontmatter.teamSlug}`
                    }
                  >
                    {frontmatter.team}
                  </a>
                </>
              )
            }

          </div>

        </header>

        {
          frontmatter.image && (
            <figure class="hero-image">

              <img
                src={frontmatter.image}
                alt={
                  frontmatter.imageAlt ??
                  frontmatter.title
                }
              />

              {
                frontmatter.imageCaption && (
                  <figcaption>
                    {
                      frontmatter.imageCaption
                    }
                  </figcaption>
                )
              }

            </figure>
          )
        }

        <div class="article-body">
          <Content />
        </div>

        {
          frontmatter.tags?.length > 0 && (
            <div class="tags">

              {
                frontmatter.tags.map(
                  (tag) => (
                    <span class="tag">
                      {tag}
                    </span>
                  )
                )
              }

            </div>
          )
        }

        {
          frontmatter.sources?.length > 0 && (
            <footer class="sources">

              <h2>Fuentes</h2>

              <ul>
                {
                  frontmatter.sources.map(
                    (source) => (
                      <li>
                        <a
                          href={source.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {source.name}
                        </a>
                      </li>
                    )
                  )
                }
              </ul>

            </footer>
          )
        }

      </article>

    </main>

  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;

    background: #f7f7f8;
    color: #111827;

    font-family:
      Arial,
      sans-serif;
  }

  .page {
    width: min(
      780px,
      calc(100% - 32px)
    );

    margin: 0 auto;

    padding:
      40px 0
      80px;
  }

  .back-link {
    display: inline-block;

    margin-bottom: 28px;

    color: #6b7280;

    text-decoration: none;

    font-size: 13px;
    font-weight: 600;
  }

  .back-link:hover {
    color: #111827;
  }

  .article {
    overflow: hidden;

    border:
      1px solid #e5e7eb;

    border-radius: 16px;

    background: #ffffff;
  }

  .article-header {
    padding:
      36px
      36px
      28px;
  }

  .article-meta {
    display: flex;

    gap: 12px;

    margin-bottom: 16px;

    color: #9ca3af;

    font-size: 12px;
    font-weight: 600;
  }

  .category {
    color: #4b5563;

    text-transform: uppercase;
  }

  h1 {
    margin:
      0
      0
      16px;

    font-size: 38px;
    line-height: 1.12;

    letter-spacing: -0.02em;
  }

  .description {
    margin:
      0
      0
      18px;

    color: #6b7280;

    font-size: 18px;
    line-height: 1.55;
  }

  .article-info {
    display: flex;

    flex-wrap: wrap;

    gap: 6px;

    color: #9ca3af;

    font-size: 12px;
  }

  .article-info a {
    color: #4b5563;

    font-weight: 600;

    text-decoration: none;
  }

  .article-info a:hover {
    text-decoration: underline;
  }

  .hero-image {
    margin: 0;
  }

  .hero-image img {
    display: block;

    width: 100%;

    max-height: 470px;

    object-fit: cover;

    background: #e5e7eb;
  }

  figcaption {
    padding:
      8px
      16px;

    color: #9ca3af;

    font-size: 11px;
  }

  .article-body {
    padding:
      30px
      36px;
  }

  .article-body :global(p) {
    margin:
      0
      0
      20px;

    color: #374151;

    font-size: 16px;
    line-height: 1.8;
  }

  .article-body :global(h2) {
    margin:
      34px
      0
      14px;

    color: #111827;

    font-size: 24px;
    line-height: 1.25;
  }

  .article-body :global(h3) {
    margin:
      28px
      0
      12px;

    font-size: 19px;
  }

  .article-body :global(strong) {
    color: #111827;
  }

  .article-body :global(a) {
    color: #111827;

    font-weight: 600;
  }

  .article-body :global(blockquote) {
    margin:
      26px
      0;

    padding:
      4px
      0
      4px
      18px;

    border-left:
      3px solid #d1d5db;

    color: #4b5563;
  }

  .tags {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    padding:
      0
      36px
      30px;
  }

  .tag {
    padding:
      6px
      10px;

    border-radius: 999px;

    background: #f3f4f6;

    color: #6b7280;

    font-size: 11px;
    font-weight: 600;
  }

  .sources {
    padding:
      24px
      36px
      30px;

    border-top:
      1px solid #f0f0f0;
  }

  .sources h2 {
    margin:
      0
      0
      12px;

    font-size: 14px;
  }

  .sources ul {
    margin: 0;

    padding-left: 18px;
  }

  .sources li {
    margin-bottom: 6px;

    color: #6b7280;

    font-size: 12px;
  }

  .sources a {
    color: #6b7280;
  }

  @media (
    max-width: 600px
  ) {
    .page {
      width:
        calc(100% - 24px);

      padding-top: 24px;
    }

    .article-header {
      padding:
        24px
        20px;
    }

    h1 {
      font-size: 30px;
    }

    .description {
      font-size: 16px;
    }

    .article-body {
      padding:
        24px
        20px;
    }

    .tags {
      padding:
        0
        20px
        24px;
    }

    .sources {
      padding:
        22px
        20px;
    }
  }
</style>