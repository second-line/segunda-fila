---
import data from "../../../data/segunda.json";

const newsModules = import.meta.glob(
  "../../../content/noticias/*.md",
  {
    eager: true
  }
);

export function getStaticPaths() {
  return data.teams.map((team) => ({
    params: {
      slug: team.slug
    },
    props: {
      team
    }
  }));
}

const { team } = Astro.props;

const relatedNews = Object.entries(newsModules)
  .map(([path, module]) => {
    const slug = path
      .split("/")
      .pop()
      ?.replace(".md", "");

    return {
      slug,
      ...(module.frontmatter ?? {})
    };
  })
  .filter(
    (article) =>
      article.teamSlug === team.slug
  )
  .sort(
    (a, b) =>
      new Date(b.date).getTime() -
      new Date(a.date).getTime()
  )
  .slice(0, 3);

function formatNewsDate(date) {
  return new Intl.DateTimeFormat(
    "es-ES",
    {
      day: "numeric",
      month: "short",
      year: "numeric"
    }
  ).format(new Date(date));
}

const statsEntry = Object.values(data.teamStats).find(
  (item) => item.slug === team.slug
);

if (!statsEntry) {
  throw new Error(`No hay estadísticas para ${team.name}`);
}

const stats = statsEntry;
const last5 = stats.last5;
const last10 = stats.last10;
const home = stats.home;
const away = stats.away;

const recentMatches = [...(stats.recentMatches ?? [])].reverse();

const formatMatchDate = (date) => {
  if (!date) {
    return "";
  }

  const value = new Date(date);

  return new Intl.DateTimeFormat(
    "es-ES",
    {
      day: "2-digit",
      month: "2-digit"
    }
  ).format(value);
};

const quickReads = [];

if (stats.winStreak >= 3) {
  quickReads.push(
    `Llega con ${stats.winStreak} victorias consecutivas`
  );
}

if (stats.unbeatenStreak >= 4) {
  quickReads.push(
    `Ya son ${stats.unbeatenStreak} partidos sin perder`
  );
}

if (stats.scoringStreak >= 4) {
  quickReads.push(
    `Ha marcado en sus últimos ${stats.scoringStreak} partidos`
  );
}

if (stats.cleanSheetStreak >= 2) {
  quickReads.push(
    `Encadena ${stats.cleanSheetStreak} partidos sin encajar`
  );
}

if (last5?.avgGoalsFor >= 1.8) {
  quickReads.push(
    `Está promediando ${last5.avgGoalsFor} goles por partido en sus últimos 5`
  );
}

if (last5?.cleanSheets >= 3) {
  quickReads.push(
    `Ha dejado la portería a cero en ${last5.cleanSheets} de sus últimos 5 partidos`
  );
}

if (last5?.over25Percentage >= 60) {
  quickReads.push(
    `En el ${last5.over25Percentage}% de sus últimos 5 partidos hubo más de 2,5 goles`
  );
}

/*
 * Si no hay suficientes tendencias destacadas,
 * completamos con datos generales.
 */

if (quickReads.length < 3 && last5) {
  quickReads.push(
    `Ha sumado ${last5.points} puntos de los últimos ${last5.played * 3} posibles`
  );
}

if (quickReads.length < 3 && last5) {
  quickReads.push(
    `Marca ${last5.avgGoalsFor} goles por partido y encaja ${last5.avgGoalsAgainst}`
  );
}

if (quickReads.length < 3 && last5) {
  if (last5.wins > last5.losses) {
    quickReads.push(
      `El balance reciente es de ${last5.wins} victorias, ${last5.draws} empates y ${last5.losses} derrotas`
    );
  } else if (last5.losses > last5.wins) {
    quickReads.push(
      `En los últimos ${last5.played} partidos suma ${last5.wins} victorias, ${last5.draws} empates y ${last5.losses} derrotas`
    );
  } else {
    quickReads.push(
      `En sus últimos ${last5.played} partidos tiene ${last5.wins} victorias, ${last5.draws} empates y ${last5.losses} derrotas`
    );
  }
}

const formLabels = {
  W: "V",
  D: "E",
  L: "D"
};

const SITE_URL = "https://segunda-fila.pages.dev";

const canonicalUrl =
  `${SITE_URL}/segunda/equipos/${team.slug}`;

const seoTitle =
  `${team.name}: estadísticas, rachas y resultados | Segunda Fila`;

const seoDescription =
  `Estadísticas, forma reciente, rachas, resultados y tendencias de ${team.name} en Segunda División.`;

const teamJsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsTeam",
  name: team.name,
  sport: "Football",
  url: canonicalUrl
};
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{seoTitle}</title>

    <meta
      name="description"
      content={seoDescription}
    />

    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Segunda Fila" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(teamJsonLd)}
    />
  </head>

  <body>
    <header class="topbar">
      <div class="container header-content">
        <a href="/" class="brand">
          <div class="logo">SF</div>

          <div>
            <h1>Segunda Fila</h1>
            <p>Fútbol más allá de Primera</p>
          </div>
        </a>
      </div>
    </header>

    <main class="container page">
      <a href="/" class="back-link">
        ← Segunda División
      </a>

      <section class="team-hero">
  <div class="team-hero-main">
    <div class="team-avatar">
      {team.name.charAt(0)}
    </div>

    <div>
      <span class="competition">
        Segunda División
      </span>

      <h2>{team.name}</h2>

      <p>
        Tendencias y estadísticas recientes
      </p>
    </div>
  </div>

  <div class="hero-stats">
    <div class="hero-stat">
      <strong>{stats.winStreak}</strong>
      <span>Victorias seguidas</span>
    </div>

    <div class="hero-stat">
      <strong>{stats.unbeatenStreak}</strong>
      <span>Sin perder</span>
    </div>

    <div class="hero-stat">
      <strong>{last5.avgGoalsFor}</strong>
      <span>Goles / partido</span>
    </div>
  </div>
</section>

      <!-- LECTURA RÁPIDA -->

      {quickReads.length > 0 && (
        <section class="panel">
          <div class="panel-header">
            <div>
              <h3>Lectura rápida</h3>
              <span>Qué destaca ahora mismo</span>
            </div>
          </div>

          <div class="quick-read-list">
            {quickReads.slice(0, 4).map((item) => (
              <div class="quick-read-item">
                <span class="quick-dot"></span>
                <p>{item}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- FORMA -->

      <section class="panel">
        <div class="panel-header">
          <div>
            <h3>Forma reciente</h3>
            <span>Últimos 5 partidos</span>
          </div>
        </div>

        <div class="form-content">
          <div class="form-list">
            {stats.form.map((result) => (
              <span
                class:list={[
                  "form-item",
                  result === "W" && "win",
                  result === "D" && "draw",
                  result === "L" && "loss"
                ]}
              >
                {formLabels[result]}
              </span>
            ))}
          </div>

          <div class="points-summary">
            <strong>{last5.points}</strong>
            <span>de 15 puntos</span>
          </div>
        </div>
      </section>

      <!-- PARTIDOS RECIENTES -->

<section class="panel">
  <div class="panel-header">
    <div>
      <h3>Partidos recientes</h3>
      <span>Últimos resultados</span>
    </div>
  </div>

  <div class="recent-matches">
    {recentMatches.map((match) => (
      <div class="recent-match">
        <div class="recent-date">
          {formatMatchDate(match.date)}
        </div>

        <div class="recent-result">
          <span
            class:list={[
              "result-badge",
              match.result === "W" && "win",
              match.result === "D" && "draw",
              match.result === "L" && "loss"
            ]}
          >
            {
              match.result === "W"
                ? "V"
                : match.result === "D"
                  ? "E"
                  : "D"
            }
          </span>
        </div>

        <div class="recent-info">
          <div class="recent-opponent">
            <span class="home-away">
              {match.isHome ? "LOCAL" : "VISITANTE"}
            </span>

            <strong>
              {match.opponent}
            </strong>
          </div>

          <div class="recent-score">
            {match.goalsFor}
            <span>-</span>
            {match.goalsAgainst}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

      <!-- RACHAS -->

      <section class="panel">
        <div class="panel-header">
          <div>
            <h3>Rachas</h3>
            <span>Qué está haciendo ahora mismo</span>
          </div>
        </div>

        <div class="stat-grid">
          <div class="stat-card">
            <span class="stat-icon">🔥</span>
            <strong>{stats.winStreak}</strong>
            <p>Victorias seguidas</p>
          </div>

          <div class="stat-card">
            <span class="stat-icon">📈</span>
            <strong>{stats.unbeatenStreak}</strong>
            <p>Partidos sin perder</p>
          </div>

          <div class="stat-card">
            <span class="stat-icon">⚽</span>
            <strong>{stats.scoringStreak}</strong>
            <p>Partidos marcando</p>
          </div>

          <div class="stat-card">
            <span class="stat-icon">🧱</span>
            <strong>{stats.cleanSheetStreak}</strong>
            <p>Porterías a cero seguidas</p>
          </div>
        </div>
      </section>

      <!-- ÚLTIMOS 5 -->

      <section class="panel">
        <div class="panel-header">
          <div>
            <h3>Últimos 5 partidos</h3>
            <span>Rendimiento reciente</span>
          </div>
        </div>

        <div class="metric-grid">
          <div class="metric">
            <span>Victorias</span>
            <strong>{last5.wins}</strong>
          </div>

          <div class="metric">
            <span>Empates</span>
            <strong>{last5.draws}</strong>
          </div>

          <div class="metric">
            <span>Derrotas</span>
            <strong>{last5.losses}</strong>
          </div>

          <div class="metric">
            <span>Goles a favor</span>
            <strong>{last5.goalsFor}</strong>
          </div>

          <div class="metric">
            <span>Goles en contra</span>
            <strong>{last5.goalsAgainst}</strong>
          </div>

          <div class="metric">
            <span>Media goles</span>
            <strong>{last5.avgGoalsFor}</strong>
          </div>
        </div>
      </section>

<!-- TENDENCIAS -->

<section class="panel">
  <div class="panel-header">
    <div>
      <h3>Tendencias de partido</h3>
      <span>Últimos 5 partidos</span>
    </div>
  </div>

  <div class="trend-stats">
    <div class="trend-stat">
      <div class="trend-stat-main">
        <div class="trend-stat-label">
          <strong>Ambos marcan</strong>
          <span>{last5.btts} de 5</span>
        </div>

        <strong>{last5.bttsPercentage}%</strong>
      </div>

      <div class="trend-bar">
        <div
          class="trend-bar-fill"
          style={`width: ${last5.bttsPercentage}%`}
        ></div>
      </div>
    </div>

    <div class="trend-stat">
      <div class="trend-stat-main">
        <div class="trend-stat-label">
          <strong>Más de 1,5 goles</strong>
          <span>{last5.over15} de 5</span>
        </div>

        <strong>{last5.over15Percentage}%</strong>
      </div>

      <div class="trend-bar">
        <div
          class="trend-bar-fill"
          style={`width: ${last5.over15Percentage}%`}
        ></div>
      </div>
    </div>

    <div class="trend-stat">
      <div class="trend-stat-main">
        <div class="trend-stat-label">
          <strong>Más de 2,5 goles</strong>
          <span>{last5.over25} de 5</span>
        </div>

        <strong>{last5.over25Percentage}%</strong>
      </div>

      <div class="trend-bar">
        <div
          class="trend-bar-fill"
          style={`width: ${last5.over25Percentage}%`}
        ></div>
      </div>
    </div>

    <div class="trend-stat">
      <div class="trend-stat-main">
        <div class="trend-stat-label">
          <strong>Más de 3,5 goles</strong>
          <span>{last5.over35} de 5</span>
        </div>

        <strong>{last5.over35Percentage}%</strong>
      </div>

      <div class="trend-bar">
        <div
          class="trend-bar-fill"
          style={`width: ${last5.over35Percentage}%`}
        ></div>
      </div>
    </div>

    <div class="trend-stat">
      <div class="trend-stat-main">
        <div class="trend-stat-label">
          <strong>Portería a cero</strong>
          <span>{last5.cleanSheets} de 5</span>
        </div>

        <strong>{last5.cleanSheetPercentage}%</strong>
      </div>

      <div class="trend-bar">
        <div
          class="trend-bar-fill"
          style={`width: ${last5.cleanSheetPercentage}%`}
        ></div>
      </div>
    </div>

    <div class="trend-stat">
      <div class="trend-stat-main">
        <div class="trend-stat-label">
          <strong>Sin marcar</strong>
          <span>{last5.failedToScore} de 5</span>
        </div>

        <strong>{last5.failedToScorePercentage}%</strong>
      </div>

      <div class="trend-bar">
        <div
          class="trend-bar-fill"
          style={`width: ${last5.failedToScorePercentage}%`}
        ></div>
      </div>
    </div>
  </div>
</section>

      <!-- LOCAL / VISITANTE -->

      <div class="split-grid">
        <section class="panel">
          <div class="panel-header">
            <div>
              <h3>Como local</h3>
              <span>Últimos {home?.played ?? 0}</span>
            </div>
          </div>

          {
            home ? (
              <div class="compact-stats">
                <div>
                  <span>Victorias</span>
                  <strong>{home.wins}</strong>
                </div>

                <div>
                  <span>Goles / partido</span>
                  <strong>{home.avgGoalsFor}</strong>
                </div>

                <div>
                  <span>Sin perder</span>
                  <strong>{home.unbeatenPercentage}%</strong>
                </div>
              </div>
            ) : (
              <div class="empty">
                Sin datos suficientes
              </div>
            )
          }
        </section>

        <section class="panel">
          <div class="panel-header">
            <div>
              <h3>Como visitante</h3>
              <span>Últimos {away?.played ?? 0}</span>
            </div>
          </div>

          {
            away ? (
              <div class="compact-stats">
                <div>
                  <span>Victorias</span>
                  <strong>{away.wins}</strong>
                </div>

                <div>
                  <span>Goles / partido</span>
                  <strong>{away.avgGoalsFor}</strong>
                </div>

                <div>
                  <span>Sin perder</span>
                  <strong>{away.unbeatenPercentage}%</strong>
                </div>
              </div>
            ) : (
              <div class="empty">
                Sin datos suficientes
              </div>
            )
          }
        </section>
      </div>

      <!-- ÚLTIMOS 10 -->

      <section class="panel">
        <div class="panel-header">
          <div>
            <h3>Perspectiva ampliada</h3>
            <span>Últimos {last10.played} partidos</span>
          </div>
        </div>

        <div class="metric-grid">
          <div class="metric">
            <span>Puntos / partido</span>
            <strong>{last10.pointsPerGame}</strong>
          </div>

          <div class="metric">
            <span>% victorias</span>
            <strong>{last10.winPercentage}%</strong>
          </div>

          <div class="metric">
            <span>% sin perder</span>
            <strong>{last10.unbeatenPercentage}%</strong>
          </div>

          <div class="metric">
            <span>Goles / partido</span>
            <strong>{last10.avgGoalsFor}</strong>
          </div>

          <div class="metric">
            <span>Encajados / partido</span>
            <strong>{last10.avgGoalsAgainst}</strong>
          </div>

          <div class="metric">
            <span>BTTS</span>
            <strong>{last10.bttsPercentage}%</strong>
          </div>
        </div>
      </section>
    
      {
        relatedNews.length > 0 && (
          <section class="panel team-news">
            <div class="panel-header">
              <div>
                <h3>Actualidad sobre {team.name}</h3>
                <span>
                  Noticias y análisis relacionados
                </span>
              </div>

              <a
                href="/segunda/noticias"
                class="team-news-all"
              >
                Ver actualidad →
              </a>
            </div>

            <div class="team-news-list">
              {relatedNews.map((article) => (
                <a
                  href={`/segunda/noticias/${article.slug}`}
                  class="team-news-item"
                >
                  {
                    article.image && (
                      <div class="team-news-image">
                        <img
                          src={article.image}
                          alt={
                            article.imageAlt ??
                            article.title
                          }
                        />
                      </div>
                    )
                  }

                  <div class="team-news-content">
                    <div class="team-news-meta">
                      <span>
                        {article.category}
                      </span>

                      <span>
                        {formatNewsDate(article.date)}
                      </span>
                    </div>

                    <strong>
                      {article.title}
                    </strong>

                    {
                      article.description && (
                        <p>
                          {article.description}
                        </p>
                      )
                    }
                  </div>

                  <span class="team-news-arrow">
                    →
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }

    </main>
  
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="site-footer-main">
          <a href="/" class="site-footer-brand">
            <span class="site-footer-logo">SF</span>

            <div class="site-footer-identity">
              <strong>Segunda Fila</strong>
              <span>Fútbol más allá de Primera</span>
            </div>
          </a>

          <p class="site-footer-description">
            Estadísticas, tendencias, partidos e historias
            del fútbol más allá de Primera División.
          </p>
        </div>

        <div class="site-footer-bottom">
          <span>© 2026 Segunda Fila</span>
          <span class="site-footer-tagline">
            El fútbol también se juega en segunda fila.
          </span>
        </div>
      </div>
    </footer>

  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #f3f4f6;
    color-scheme: light;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;

    background: #f3f4f6;
    color: #202124;

    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .container {
    width: min(900px, 94%);
    margin: 0 auto;
  }

  .topbar {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .header-content {
    padding: 18px 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;

    color: inherit;
    text-decoration: none;
  }

  .logo {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    background: #111827;
    color: white;

    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: 20px;
  }

  .brand p {
    margin: 3px 0 0;

    color: #6b7280;

    font-size: 13px;
  }

  .page {
    display: flex;
    flex-direction: column;
    gap: 20px;

    padding: 24px 0 60px;
  }

  .back-link {
    width: fit-content;

    color: #6b7280;

    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
  }

  .back-link:hover {
    color: #111827;
  }

  

  .team-avatar {
    flex-shrink: 0;

    width: 56px;
    height: 56px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #111827;
    color: white;

    font-size: 20px;
    font-weight: 800;
  }

  .competition {
    color: #9ca3af;

    font-size: 11px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

/* HERO EQUIPO */

.team-hero {
  overflow: hidden;

  background: #ffffff;

  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.team-hero-main {
  display: flex;
  align-items: center;

  gap: 16px;

  padding: 22px 22px 18px;
}

.team-hero-main h2 {
  margin: 3px 0 2px;

  font-size: 26px;
}

.team-hero-main p {
  margin: 0;

  color: #6b7280;

  font-size: 13px;
}

.hero-stats {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  border-top: 1px solid #eeeeee;
}

.hero-stat {
  display: flex;
  flex-direction: column;

  gap: 4px;

  padding: 18px 20px;

  border-right: 1px solid #eeeeee;

  text-align: center;
}

.hero-stat:last-child {
  border-right: none;
}

.hero-stat strong {
  color: #111827;

  font-size: 24px;
  font-weight: 800;
}

.hero-stat span {
  color: #6b7280;

  font-size: 11px;
  font-weight: 600;
}
 

  .panel {
    overflow: hidden;

    background: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 12px;
  }

  .panel-header {
    padding: 16px 20px;

    border-bottom: 1px solid #eeeeee;
  }

  .panel-header h3 {
    margin: 0;

    font-size: 15px;
  }

  .panel-header span {
